#!/usr/bin/env bash
set -euo pipefail

# Run after applying the files, from inside an Omarchy desktop session.
: "${HYPRLAND_INSTANCE_SIGNATURE:?Run from the active Hyprland session}"
command -v omarchy >/dev/null
hyprctl reload
errors=$(hyprctl configerrors)
if [[ -n "$errors" && "$errors" != "ok" ]]; then
  printf '%s\n' "$errors" >&2
  exit 1
fi
systemctl --user daemon-reload
systemctl --user import-environment HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY XDG_RUNTIME_DIR
systemctl --user enable --now omarchy-hot-corner-lock.service
systemctl --user restart omarchy-hot-corner-lock.service
omarchy toggle screensaver-off on
omarchy toggle suspend-off on
omarchy-shell idle enable
omarchy-shell idle status
