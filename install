#!/usr/bin/env python3
"""Install the personal Omarchy configuration; preview unless --write is given."""
import argparse
from pathlib import Path
import subprocess
import sys

repo = Path(__file__).resolve().parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--write', action='store_true', help='back up and install changed files')
parser.add_argument('--activate', action='store_true', help='also reload the desktop and apply Omarchy preferences')
parser.add_argument('--home', type=Path, help='alternate destination home for restore tests')
args = parser.parse_args()
if args.activate and (not args.write or args.home is not None):
    parser.error('--activate requires --write and cannot be used with --home')
command = [sys.executable, str(repo / 'scripts/dotfiles'), 'apply']
if args.write:
    command.append('--write')
if args.home is not None:
    command.extend(['--home', str(args.home)])
result = subprocess.run(command)
if result.returncode:
    sys.exit(result.returncode)
if args.activate:
    sys.exit(subprocess.run([str(repo / 'scripts/activate-omarchy')]).returncode)
